APP_NAME="Workshop Commerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
ADMIN_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=workshop
DB_USERNAME=workshop
DB_PASSWORD=change-me

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Pointet"

FRONTEND_VERIFY_URL=http://localhost:3000/home
FRONTEND_URL=http://localhost:3000
# `preorder` creates a fixed €1 Stripe Checkout session; `standard` leaves normal orders unchanged.
CHECKOUT_MODE=preorder
# STRIPE_SECRET is also accepted for compatibility with the existing local setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/profile/basket?preorder=cancelled
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
AUTH_ACCESS_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_EMAIL_CHANGE_CODE_TTL_MINUTES=15
API_GET_RATE_LIMIT=300
API_WRITE_RATE_LIMIT=120
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=10
PASSWORD_CHANGE_RATE_LIMIT=10
EMAIL_CHANGE_RATE_LIMIT=10
EMAIL_VERIFY_RATE_LIMIT=10
REFRESH_RATE_LIMIT=60
# Local requests use this multiplier; set it to 1 to mirror production locally.
LOCAL_API_RATE_LIMIT_MULTIPLIER=10
AUTH_PENDING_TTL_HOURS=24
AUTH_PENDING_STORE=redis
AUTH_ACCESS_COOKIE=access_token
AUTH_REFRESH_COOKIE=refresh_token
AUTH_COOKIE_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
AUTH_JWT_ISSUER=http://localhost:8080
AUTH_JWT_AUDIENCE=http://localhost:8080
AUTH_JWT_KEY_ID=primary
AUTH_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_DUMMY_PASSWORD_HASH=$2y$12$w5Yg6HXS4wGQbrLwxVaOgOXg6Zl7k2MZ4d5d7bZk5YH5Bqg.fR1ly

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Keep true for private S3 buckets; use false only with a public bucket/CDN URL.
AWS_SIGNED_URLS=true
