NEXT_PUBLIC_PHOTON_URL=https://photon.komoot.io/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legal identity of the business that operates the site. The legal documents
# (/docs/…) reference these values, so a change of status (for example from a
# micro-entreprise to a SASU) only needs new values here. Read by the server
# at request time; a value left empty shows as "[LEGAL_…]" on the page.
LEGAL_OPERATOR_NAME="Prénom NOM EI"
LEGAL_TRADE_NAME="Pointet"
LEGAL_FORM="entrepreneur individuel (micro-entrepreneur)"
LEGAL_SIREN="000 000 000"
LEGAL_SIRET="000 000 000 00000"
LEGAL_REGISTRY="Registre national des entreprises (RNE)"
LEGAL_ADDRESS="1 rue Exemple, 75000 Paris, France"
# The VAT number, or the mention required under the VAT franchise.
LEGAL_VAT="TVA non applicable, art. 293 B du CGI"
LEGAL_EMAIL="support@pointet.fr"
LEGAL_PHONE="+33 0 00 00 00 00"
LEGAL_HOSTING_NAME="Nom de l'hébergeur"
LEGAL_HOSTING_ADDRESS="Adresse de l'hébergeur"
LEGAL_HOSTING_PHONE="+33 0 00 00 00 00"
# Consumer mediator the business has signed up with (mandatory for B2C sales in France).
LEGAL_MEDIATOR_NAME="Nom du médiateur de la consommation"
LEGAL_MEDIATOR_URL="https://www.mediateur.example"
